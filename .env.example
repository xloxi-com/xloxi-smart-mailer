# =============================================================================
# XLOXI Smart Product Mailer — environment template
# Copy to `.env` for local use. NEVER commit real secrets.
# Production: load from Google Secret Manager (see docs/DEPLOYMENT.md).
# =============================================================================

# --- Database (Supabase PostgreSQL) ---
# DATABASE_URL: pooled URL for the app (Supabase "Transaction" pooler :6543
#               or Session mode). Use ?pgbouncer=true&connection_limit=1 for
#               Prisma + PgBouncer transaction pooling.
# DIRECT_URL:   direct Postgres (port 5432) for `prisma migrate deploy` only.
#               Never point migrate at the transaction pooler.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# --- Shopify (Partner Dashboard / custom distribution) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS origin of the Cloud Run web service (no trailing slash)
SHOPIFY_APP_URL=https://YOUR_CLOUD_RUN_URL
SCOPES=read_products,read_inventory,read_customers,write_customers
# Optional custom shop hostname
# SHOP_CUSTOM_DOMAIN=seductiv.net

# --- Email safety (keep dry-run until merchant approves live sending) ---
EMAIL_SENDING_ENABLED=false
EMAIL_PROVIDER=dry_run
EMAIL_PROVIDER_APPROVED=false
# EMAIL_TEST_ALLOWLIST=ops@example.com
# EMAIL_ALLOW_MOCK_WEBHOOKS=false
UNSUBSCRIBE_SIGNING_SECRET=

# --- Job / scheduler authentication ---
# Required in production. Shared secret for /api/jobs/* and Cron.
JOBS_SHARED_SECRET=
# Optional alias accepted by authorizeJobsRequest
# CRON_SECRET=
# Optional audience label for ops docs (shared secret still required)
# JOBS_OIDC_AUDIENCE=https://YOUR_CLOUD_RUN_URL/api/jobs/scheduler
# Dev-only: JOBS_ALLOW_INSECURE=true (never in production)

# --- Worker bounds (Cloud Run Jobs) ---
WORKER_BATCH_SIZE=20
WORKER_CONCURRENCY=5
WORKER_MAX_RUNTIME_MS=240000
WORKER_LEASE_MS=120000
WEBHOOK_WORKER_BATCH_SIZE=25

# --- Runtime ---
NODE_ENV=production
PORT=8080
# HOST=0.0.0.0
# SHOPIFY_APP_SKIP_ENV_VALIDATION=1  # build/CI only — never in live Cloud Run
